# Configure these in Vercel Project Settings > Environment Variables.
EMAILJS_PUBLIC_KEY=replace_with_emailjs_public_key
EMAILJS_SERVICE_ID=replace_with_emailjs_service_id
EMAILJS_TEMPLATE_ID=replace_with_emailjs_template_id
# Optional when your EmailJS account/template uses a private access token.
EMAILJS_PRIVATE_KEY=

# Optional but strongly recommended. When set, also place the matching public
# site key in index.html: <meta name="turnstile-site-key" content="...">
TURNSTILE_SECRET_KEY=
